# Plugin build output
Plugins/**/Binaries/
Plugins/**/Intermediate/

# ---- legacy generated SDK data -------------------------------------------
# Current builds write Portal-SDK-derived caches to
# Saved/BF6UnrealSDK/sdkdata (covered by Saved/ above). Keep these old Source/
# ignores until every pre-migration checkout has launched once; startup moves
# them into Saved without duplicating the multi-GB packs.
Plugins/BF6UnrealSDK/Source/ThirdParty/libbf6/data/objmodels/
Plugins/BF6UnrealSDK/Source/ThirdParty/libbf6/data/mapmesh/

# Per-user SDK history from old builds. The baked history remains a Resource;
# mutable snapshots now live under Saved with the other generated data.
Plugins/BF6UnrealSDK/Source/ThirdParty/libbf6/data/sdkhistory/

# local fresh-install test backups
*_FRESHTEST_BACKUP/

# SDK history harvester downloads (the script itself is tracked)
tools/sdk_history/work/

# The High Poly add-on lives in its own repository
# (TabbedScamper/BF6_Unreal_SDK_High_Poly) and must never ship with the base
# plugin - it is developed in this working tree but released separately.
Plugins/Add-Ons/
